@page "/register"
@using MudBlazor
@using Blazored.FluentValidation
@using ExpenseTracker.UI.Authentication
@using ExpenseTracker.UI.Languages
@using ExpenseTracker.UI.Models
@using ExpenseTracker.UI.Services
@inject NavigationManager NavigationManager
@inject IRegisterService Service
@inject ISnackbar Snackbar
@inject ITranslateService TranslateService
@inject IAuthStateService AuthStateService

<MudPaper Class="pa-6 mx-auto mt-12" MaxWidth="500px" Elevation="8">
    <MudText Typo="Typo.h5" Class="mb-4" data-name="register-text">Rejestracja</MudText>

    <EditForm Model="@model" OnValidSubmit="HandleRegister" data-name="register-form">
        <FluentValidationValidator />

        <MudTextField @bind-Value="model.FirstName" Label='@(TranslateService.Translate("RegisterForm.FirstNameControlName"))' For="@(() => model.FirstName)" data-name="register-form-first-name" />
        <MudTextField @bind-Value="model.LastName" Label='@(TranslateService.Translate("RegisterForm.LastNameControlName"))' For="@(() => model.LastName)" data-name="register-form-last-name" />
        <MudTextField @bind-Value="model.Email" Label='@(TranslateService.Translate("RegisterForm.EmailControlName"))' For="@(() => model.Email)" data-name="register-form-email" />
        <MudTextField @bind-Value="model.Password" Label='@(TranslateService.Translate("RegisterForm.PasswordControlName"))' For="@(() => model.Password)" InputType="InputType.Password" data-name="register-form-password" />
        <MudTextField @bind-Value="model.ConfirmPassword" Label='@(TranslateService.Translate("RegisterForm.ConfirmPasswordControlName"))' For="@(() => model.ConfirmPassword)" InputType="InputType.Password" data-name="register-form-confirm-password" />

        <MudButton Variant="Variant.Filled" Color="Color.Secondary" Class="mt-4" FullWidth="true" ButtonType="ButtonType.Submit" data-name="register-form-submit-button">
            Zarejestruj się
        </MudButton>
    </EditForm>

    <MudText Class="mt-4" data-name="register-form-account-exists">
        Masz już konto?
        <MudLink Href="/login" data-name="register-form-login-link">Zaloguj się</MudLink>
    </MudText>
</MudPaper>

@code {
    private RegisterForm model = new();

    private async Task HandleRegister()
    {
        var result = await Service.Register(model.ToDto());
        if (!result.Valid)
        {
            if (result.ErrorMessage is not null)
            {
                Snackbar.Add(TranslateService.Translate(result.ErrorMessage), Severity.Error);
            }

            return;
        }

        await AuthStateService.LoginAsync(result.Data!.AccessToken);
        NavigationManager.NavigateTo("/");
    }
}
